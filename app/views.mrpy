{fun _icon_class [kind extra_class]
    class_name = "icon-shell icon-" + kind
    {if extra_class == "" class_name class_name + " " + extra_class}
}


{fun _file_icon_kind [kind]
    {if kind == "content"
        "content_file"
        kind == "data"
            "data"
        kind == "layout"
            "layout"
        kind == "media"
            "media_file"
        kind == "dir"
            "dir"
        "file"}
}


{fun nav_item_node [href label kicker icon_kind active]
    active_class = {if active "nav-item nav-item-active" "nav-item"}

    {$mrml_node a [class={$ active_class} href={$ href}]
        {span [class={$ {_icon_class icon_kind "nav-icon"}}]}
        {span [class="nav-label"] {$ label}}
        {span [class="nav-kicker"] {$ kicker}}
    }
}


{fun nav_items_node []
    [
        {nav_item_node "#overview" "Dashboard" "01" "dashboard" true}
        {nav_item_node "#browser" "Explorer" "02" "explorer" false}
        {nav_item_node "#content" "Content" "03" "content" false}
        {nav_item_node "#media" "Media" "04" "media" false}
        {nav_item_node "#deploy" "Deployment" "05" "deploy" false}
    ]
}


{fun metric_card_node [section]
    card_class = "metric-card metric-card-" + {section.get "kind" "file"}
    icon_kind = {_file_icon_kind {section.get "kind" "file"}}

    {$mrml_node article [class={$ card_class}]
        {span [class={$ {_icon_class icon_kind "metric-icon"}}]}
        {p [class="meta-label"] {$ {section.get "label" ""}}}
        {p [class="metric-value"] {$ {section.get "count" 0}}}
        {p [class="metric-copy"] {$ {section.get "description" ""}}}
        {p [class="metric-path"] {$ {section.get "path" ""}}}
    }
}


{fun metric_cards_nodes [sections]
    sections | {map metric_card_node _} | list
}


{fun next_step_node [step]
    {$mrml_node li [class="step-item"]
        {span [class="step-bullet"] "•"}
        {span {$ step}}
    }
}


{fun next_steps_nodes [steps]
    steps | {map next_step_node _} | list
}


{fun recent_file_row_node [entry]
    href = {entry.get "href" "#"}
    icon_kind = {_file_icon_kind {entry.get "kind" ""}}

    {$mrml_node a [class="recent-row" href={$ href}]
        {span [class={$ {_icon_class icon_kind "recent-icon"}}]}
        {div [class="recent-main"]
            {p [class="recent-name"] {$ {entry.get "name" ""}}}
            {p [class="recent-path"] {$ {entry.get "rel_path" ""}}}
        }
        {div [class="recent-meta"]
            {span [class="data-chip"] {$ {entry.get "kind" ""}}}
            {span [class="recent-time"] {$ {entry.get "modified_text" ""}}}
            {span [class="recent-size"] {$ {entry.get "size_text" ""}}}
        }
    }
}


{fun recent_files_nodes [entries]
    entries | {map recent_file_row_node _} | list
}


{fun browser_entry_node [entry]
    depth = {entry.get "depth" 0}
    kind = {entry.get "kind" "file"}
    href = {entry.get "href" "#"}
    rel_path = {entry.get "rel_path" ""}
    selected_class = {if {entry.get "is_selected" false} " explorer-entry-selected" ""}
    kind_class = {if kind == "dir" " explorer-entry-dir" " explorer-entry-file"}
    indent_amount = depth + 1
    indent_style = "padding-left: " + {str indent_amount} + "rem"
    link_class = "explorer-entry" + selected_class + kind_class
    icon_kind = {_file_icon_kind {if kind == "dir" "dir" {entry.get "kind" "file"}}}

    {$mrml_node li
        {a [
            class={$ link_class}
            href={$ href}
            style={$ indent_style}
        ]
            {span [class={$ {_icon_class icon_kind "explorer-icon"}}]}
            {span [class="explorer-entry-name"] {$ rel_path}}
        }
    }
}


{fun browser_entries_nodes [entries]
    entries | {map browser_entry_node _} | list
}


{fun _selected_preview_text [selected]
    {if selected == null
        ""
        {selected.get "preview" ""}}
}


{fun _selected_rel_path [selected]
    {if selected == null
        ""
        {selected.get "rel_path" ""}}
}


{fun _selected_suffix [selected]
    {if selected == null
        ""
        {{selected.get "suffix" ""}.lower}}
}


{fun _selected_mode [selected]
    rel_path = {_selected_rel_path selected}
    suffix = {_selected_suffix selected}

    {when {rel_path.startswith "content/"}
        {return "content"}}
    {when {rel_path.startswith "data/"} || suffix == ".mron"
        {return "mron"}}
    {when {rel_path.startswith "layouts/"} || [".html" ".css" ".js" ".ts" ".scss"].__contains__ suffix
        {return "template"}}
    {when [".png" ".jpg" ".jpeg" ".gif" ".svg" ".webp"].__contains__ suffix
        {return "asset"}}
    "text"
}


{fun _split_front_matter [text]
    {when {not {text.startswith "---\n"}}
        {return {dict
            "has_front_matter" false
            "front_matter" ""
            "body" text}}}

    closing = {text.find "\n---\n" 4}
    {if closing == -1
        {dict
            "has_front_matter" false
            "front_matter" ""
            "body" text}
        {do
            front_matter_text = text @ (4 .. closing)
            body_text = text @ ((closing + 5) .. null)
            {dict
                "has_front_matter" true
                "front_matter" front_matter_text
                "body" body_text}}}
}


{fun _summary_title [selected]
    mode = {_selected_mode selected}
    {if mode == "content"
        "Hugo content editor"
        mode == "mron"
            "MRON workspace"
        mode == "template"
            "Template workspace"
        mode == "asset"
            "Asset preview"
        "Text workspace"}
}


{fun _summary_copy [selected]
    mode = {_selected_mode selected}
    {if mode == "content"
        "Front matter and body should stay side by side, with preview and metadata close at hand."
        mode == "mron"
            "Data files should stay readable, structured, and Hugo-aware rather than feel like anonymous text blobs."
        mode == "template"
            "Template and asset support should stay readable and Hugo-aware, with metadata close to the file."
        mode == "asset"
            "Static files should surface metadata and preview affordances before editing flows land."
        "Plain text files should still open in the main editor surface with contextual metadata."}
}


{fun _front_matter_lines [front_matter_text]
    {if front_matter_text == ""
        []
        {front_matter_text.split "\n"}}
}


{fun _front_matter_field_pairs [front_matter_text]
    fields = []
    {for raw_line {_front_matter_lines front_matter_text}
        line = {raw_line.strip}
        {when line == ""
            {continue}}
        {when line.startswith "#"
            {continue}}
        separator = {line.find ":"}
        {when separator == -1
            {continue}}
        key = {line @ (0 .. separator)} | {str.strip _}
        value = {line @ ((separator + 1) .. null)} | {str.strip _}
        {when key == ""
            {continue}}
        {fields.append [key value]}}
    fields
}


{fun _front_matter_summary_rows [front_matter]
    {if {front_matter.get "has_front_matter" false}
        {_front_matter_field_pairs {front_matter.get "front_matter" ""}}
        []}
}


{fun front_matter_field_node [pair]
    {$mrml_node div [class="field-row"]
        {span [class="field-label"] {$ pair@0}}
        {span [class="field-value"] {$ pair@1}}
    }
}


{fun front_matter_field_nodes [pairs]
    pairs | {map front_matter_field_node _} | list
}


{fun front_matter_field_grid_node [pairs]
    {$mrml_node div [class="field-grid"]
        {$ {front_matter_field_nodes pairs}}}
}


{fun front_matter_form_fields_node [pairs]
    {if {len pairs} > 0
        {front_matter_field_grid_node pairs}
        []}
}


{fun front_matter_preview_block_node [front_matter pairs]
    {if {len pairs} > 0
        {front_matter_field_grid_node pairs}
        {$mrml_node pre [class="editor-preview editor-preview-short"] {$ {front_matter.get "front_matter" ""}}}}
}


{fun _markdown_heading_level [line]
    stripped = {line.lstrip}
    {if {stripped.startswith "###### "}
        6
        {stripped.startswith "##### "}
            5
        {stripped.startswith "#### "}
            4
        {stripped.startswith "### "}
            3
        {stripped.startswith "## "}
            2
        {stripped.startswith "# "}
            1
        0}
}


{fun _markdown_heading_text [line level]
    stripped = {line.lstrip}
    sliced = {stripped.__getitem__ {slice level + 1 null null}}
    {sliced.strip}
}


{fun markdown_heading_node [line]
    level = {_markdown_heading_level line}
    text = {_markdown_heading_text line level}
    {if level == 1
        {$mrml_node h1 [class="markdown-heading markdown-heading-1"] {$ text}}
        level == 2
            {$mrml_node h2 [class="markdown-heading markdown-heading-2"] {$ text}}
        level == 3
            {$mrml_node h3 [class="markdown-heading markdown-heading-3"] {$ text}}
        level == 4
            {$mrml_node h4 [class="markdown-heading markdown-heading-4"] {$ text}}
        level == 5
            {$mrml_node h5 [class="markdown-heading markdown-heading-5"] {$ text}}
        {$mrml_node h6 [class="markdown-heading markdown-heading-6"] {$ text}}}
}


{fun markdown_paragraph_node [text]
    {$mrml_node p [class="markdown-paragraph"] {$ text}}
}


{fun markdown_list_item_node [text]
    {$mrml_node li {$ text}}
}


{fun markdown_list_node [items]
    item_nodes = []
    {for item items
        {item_nodes.append {markdown_list_item_node item}}}

    {$mrml_node ul [class="markdown-list"]
        {$ item_nodes}}
}


{fun _flush_markdown_paragraph [nodes paragraph_lines]
    {when {len paragraph_lines} == 0
        {return null}}

    paragraph_text = {paragraph_lines.join " "}
    {nodes.append {markdown_paragraph_node paragraph_text}}
    {paragraph_lines.clear}
}


{fun _flush_markdown_list [nodes list_items]
    {when {len list_items} == 0
        {return null}}

    {nodes.append {markdown_list_node list_items}}
    {list_items.clear}
}


{fun markdown_preview_nodes [text]
    lines = {text.split "\n"}
    nodes = []
    paragraph_lines = []
    list_items = []

    {for raw_line lines
        line = {raw_line.rstrip}
        stripped = {line.strip}
        heading_level = {_markdown_heading_level line}
        is_list_item = stripped.startswith "- "

        {when stripped == ""
            {_flush_markdown_paragraph nodes paragraph_lines}
            {_flush_markdown_list nodes list_items}
            {continue}}

        {when heading_level > 0
            {_flush_markdown_paragraph nodes paragraph_lines}
            {_flush_markdown_list nodes list_items}
            {nodes.append {markdown_heading_node line}}
            {continue}}

        {when is_list_item
            {_flush_markdown_paragraph nodes paragraph_lines}
            item_text = {stripped.__getitem__ {slice 2 null null}}
            {list_items.append {item_text.strip}}
            {continue}}

        {_flush_markdown_list nodes list_items}
        {paragraph_lines.append stripped}}

    {_flush_markdown_paragraph nodes paragraph_lines}
    {_flush_markdown_list nodes list_items}
    nodes
}


{fun _diagnostic_items [selected]
    mode = {_selected_mode selected}
    text = {_selected_preview_text selected}
    front_matter = {_split_front_matter text}
    front_matter_rows = {_front_matter_summary_rows front_matter}

    {if mode == "content"
        [
            {if {front_matter.get "has_front_matter" false}
                "Front matter detected and separated from body preview."
                "No front matter block detected yet; content editing should highlight this."}
            {if {front_matter.get "has_front_matter" false}
                "Parsed " + {{front_matter_rows | len} | str} + " top-level front matter field(s)."
                "Content file is currently body-only."}
        ]
        mode == "mron"
            ["Data file detected. Hugo sites usually prefer YAML, TOML, or JSON data files here."]
        mode == "template"
            ["Template-like file detected. Keep syntax support and Hugo context visible in the side panel."]
        ["Read-only bootstrap mode is active. Save flow, validation, and richer preview come next."]}
}


{fun diagnostic_item_node [item]
    {$mrml_node li [class="context-item"]
        {span [class="context-dot"] "•"}
        {span {$ item}}
    }
}


{fun diagnostic_nodes [items]
    items | {map diagnostic_item_node _} | list
}


{fun field_row_node [label value]
    {$mrml_node div [class="field-row"]
        {span [class="field-label"] {$ label}}
        {span [class="field-value"] {$ value}}
    }
}


{fun content_edit_form_node [rel_path selected front_matter front_matter_rows front_matter_text body_text]
    {$mrml_node form [class="editor-form" method="post" action="/save"]
        {input [type="hidden" name="path" value={$ rel_path}]}
        {input [type="hidden" name="expected_modified" value={$ {selected.get "modified" ""}}]}
        {input [type="hidden" name="save_mode" value="content_split"]}
        {div [class="editor-split"]
            {section [class="editor-subpanel"]
                {div [class="subpanel-head"]
                    {p [class="meta-label"] "Front matter"}
                    {span [class="data-chip"] {$ {if {front_matter.get "has_front_matter" false} "detected" "new"}}}
                }
                {$ {front_matter_form_fields_node front_matter_rows}}
                {label [class="editor-label" for="editor-front-matter"]
                    "Front matter source"}
                {textarea [id="editor-front-matter" class="editor-textarea editor-textarea-short" name="front_matter"] {$ front_matter_text}}
            }
            {section [class="editor-subpanel"]
                {div [class="subpanel-head"]
                    {p [class="meta-label"] "Body"}
                    {span [class="data-chip"] "markdown"}
                }
                {label [class="editor-label" for="editor-body"]
                    "Body source"}
                {textarea [id="editor-body" class="editor-textarea" name="body"] {$ body_text}}
            }
        }
        {div [class="editor-actions"]
            {button [type="submit" class="primary-button"]
                {span [class={$ {_icon_class "save" "button-icon"}}]}
                "Save content"}
            {p [class="muted"] "Front matter and body are saved back as one ordinary Hugo content file."}
        }
    }
}


{fun text_edit_form_node [rel_path selected content_text]
    {$mrml_node form [class="editor-form" method="post" action="/save"]
        {input [type="hidden" name="path" value={$ rel_path}]}
        {input [type="hidden" name="expected_modified" value={$ {selected.get "modified" ""}}]}
        {label [class="editor-label" for="editor-content"]
            "Document source"}
        {textarea [id="editor-content" class="editor-textarea" name="content"] {$ content_text}}
        {div [class="editor-actions"]
            {button [type="submit" class="primary-button"]
                {span [class={$ {_icon_class "save" "button-icon"}}]}
                "Save file"}
            {p [class="muted"] "This first save flow writes directly to the local Hugo workspace and blocks conflicting older edits."}
        }
    }
}


{fun content_preview_node [front_matter front_matter_rows markdown_nodes]
    {$mrml_node div [class="editor-split"]
        {section [class="editor-subpanel"]
            {div [class="subpanel-head"]
                {p [class="meta-label"] "Front matter"}
                {span [class="data-chip"] {$ {if {front_matter.get "has_front_matter" false} "detected" "pending"}}}
            }
            {$ {front_matter_preview_block_node front_matter front_matter_rows}}
        }
        {section [class="editor-subpanel"]
            {div [class="subpanel-head"]
                {p [class="meta-label"] "Body preview"}
                {span [class="data-chip"] "markdown"}
            }
            {div [class="editor-preview editor-preview-prose"]
                {$ markdown_nodes}}
        }
    }
}


{fun raw_preview_node [text]
    {$mrml_node pre [class="editor-preview"] {$ text}}
}


{fun context_front_matter_body_node [front_matter]
    {if {front_matter.get "has_front_matter" false}
        {$mrml_node pre [class="context-preview"] {$ {front_matter.get "front_matter" ""}}}
        {$mrml_node p [class="section-copy"] "No front matter preview available for this content file."}}
}


{fun context_front_matter_node [front_matter]
    {$mrml_node div [class="context-card"]
        {p [class="meta-label"] "Front matter"}
        {$ {context_front_matter_body_node front_matter}}
    }
}


{fun context_front_matter_fields_body_node [front_matter_rows]
    {if {len front_matter_rows} > 0
        {front_matter_field_grid_node front_matter_rows}
        {$mrml_node p [class="section-copy"] "No simple top-level `key: value` fields were extracted from the current front matter block."}}
}


{fun context_front_matter_fields_node [front_matter_rows]
    {$mrml_node div [class="context-card"]
        {p [class="meta-label"] "Front matter fields"}
        {$ {context_front_matter_fields_body_node front_matter_rows}}
    }
}


{fun context_data_preview_node [text]
    {$mrml_node div [class="context-card"]
        {p [class="meta-label"] "Data preview"}
        {pre [class="context-preview"] {$ text}}
    }
}


{fun flash_banner_node [flash]
    {when flash == null
        {return []}}

    kind = {flash.get "kind" "info"}
    banner_class = "flash-banner flash-banner-" + kind

    {$mrml_node section [class={$ banner_class}]
        {p [class="meta-label"] {$ kind}}
        {p {$ {flash.get "message" ""}}}
    }
}


{fun selected_context_panel_node [state]
    selected = {state.get "selected_file"}
    text = {_selected_preview_text selected}
    front_matter = {_split_front_matter text}
    mode = {_selected_mode selected}
    diagnostics = {_diagnostic_items selected}
    rel_path = {state.get "selected_rel_path" ""}
    front_matter_rows = {_front_matter_summary_rows front_matter}

    {if selected == null
        {$mrml_node aside [class="surface-panel context-panel"]
            {div [class="section-head"]
                {div
                    {p [class="meta-label"] "Context"}
                    {h2 "Inspector"}
                }
                {span [class="data-chip"] "workspace"}
            }
            {div [class="context-stack"]
                {p [class="section-copy"] "Pick a file from the explorer to inspect front matter, preview notes, and implementation cues."}
                {div [class="field-grid"]
                    {$ {field_row_node "Focus" "Three-pane Hugo editing"}}
                    {$ {field_row_node "MRON" "Validation-first"}}
                    {$ {field_row_node "Preview" "Local-first"}}
                }
            }
        }
        {selected.get "error"}
            {$mrml_node aside [class="surface-panel context-panel"]
                {div [class="section-head"]
                    {div
                        {p [class="meta-label"] "Context"}
                        {h2 "Inspector"}
                    }
                    {span [class="data-chip data-chip-warn"] "error"}
                }
                {div [class="context-stack"]
                    {p [class="section-copy"] {$ {selected.get "error" ""}}}
                }
            }
        {selected.get "kind"} == "dir"
            {$mrml_node aside [class="surface-panel context-panel"]
                {div [class="section-head"]
                    {div
                        {p [class="meta-label"] "Context"}
                        {h2 "Inspector"}
                    }
                    {span [class="data-chip"] "dir"}
                }
                {div [class="context-stack"]
                    {p [class="section-copy"] "Directories should drive navigation, filters, and creation actions rather than occupy the main editor pane."}
                    {div [class="field-grid"]
                        {$ {field_row_node "Directory" {selected.get "name" ""}}}
                        {$ {field_row_node "Path" rel_path}}
                    }
                }
            }
        {$mrml_node aside [class="surface-panel context-panel"]
            {div [class="section-head"]
                {div
                    {p [class="meta-label"] "Context"}
                    {h2 "Inspector"}
                }
                {span [class="data-chip"] {$ mode}}
            }
            {div [class="context-stack"]
                {div [class="context-card"]
                    {p [class="meta-label"] "Editing mode"}
                    {h3 {$ {_summary_title selected}}}
                    {p [class="section-copy"] {$ {_summary_copy selected}}}
                }
                {div [class="context-card"]
                    {p [class="meta-label"] "File facts"}
                    {div [class="field-grid"]
                        {$ {field_row_node "Path" rel_path}}
                        {$ {field_row_node "Suffix" {selected.get "suffix" ""}}}
                        {$ {field_row_node "Size" {str {selected.get "size" 0}} + " bytes"}}
                    }
                }
                {div [class="context-card"]
                    {p [class="meta-label"] "Diagnostics"}
                    {ul [class="context-list"]
                        {$ {diagnostic_nodes diagnostics}}
                    }
                }
                {$ {if mode == "content"
                    {context_front_matter_node front_matter}
                    []}}
                {$ {if mode == "mron"
                    {context_data_preview_node text}
                    []}}
                {$ {if mode == "content"
                    {context_front_matter_fields_node front_matter_rows}
                    []}}
            }
        }}
}


{fun selected_file_panel_node [state]
    selected = {state.get "selected_file"}
    rel_path = {state.get "selected_rel_path" ""}
    text = {_selected_preview_text selected}
    mode = {_selected_mode selected}
    content_text = {if selected == null "" {selected.get "content" text}}
    front_matter = {_split_front_matter content_text}
    front_matter_text = {front_matter.get "front_matter" ""}
    body_text = {front_matter.get "body" content_text}
    editable = {if selected == null false {selected.get "editable" false}}
    front_matter_rows = {_front_matter_summary_rows front_matter}
    markdown_nodes = {markdown_preview_nodes body_text}
    edit_form_node = {if editable
        {if mode == "content"
            {content_edit_form_node rel_path selected front_matter front_matter_rows front_matter_text body_text}
            {text_edit_form_node rel_path selected content_text}}
        []}
    preview_node = {if mode == "content"
        {content_preview_node front_matter front_matter_rows markdown_nodes}
        {raw_preview_node text}}

    {if selected == null
        {$mrml_node section [class="editor-panel"]
            {div [class="editor-panel-head"]
                {div
                    {p [class="meta-label"] "Editor"}
                    {h3 "Choose a file to inspect"}
                }
                {span [class="data-chip"] "read-only"}
            }
            {div [class="editor-note"]
                {p "Open a Hugo content file, data document, or template from the explorer to inspect it here."}
                {p [class="muted"] "This central pane is reserved for the editor surface, with context and preview information pushed to the right-hand inspector."}
            }
        }
        {selected.get "error"}
            {$mrml_node section [class="editor-panel"]
                {div [class="editor-panel-head"]
                    {div
                        {p [class="meta-label"] "Editor"}
                        {h3 {$ rel_path}}
                    }
                    {span [class="data-chip data-chip-warn"] "error"}
                }
                {p [class="muted"] {$ {selected.get "error" ""}}}
            }
        {selected.get "kind"} == "dir"
            {$mrml_node section [class="editor-panel"]
                {div [class="editor-panel-head"]
                    {div
                        {p [class="meta-label"] "Directory"}
                        {h3 {$ {selected.get "name" ""}}}
                    }
                    {span [class="data-chip"] "folder"}
                }
                {p [class="editor-path"] {$ {selected.get "rel_path" ""}}}
                {p [class="muted"] "This path is a directory. Pick a file entry to inspect text content and metadata."}
            }
        {$mrml_node section [class="editor-panel"]
            {div [class="editor-panel-head"]
                {div
                    {p [class="meta-label"] {$ {_summary_title selected}}}
                    {h3 {$ {selected.get "name" ""}}}
                }
                {span [class="data-chip"] {$ {if editable mode "read-only"}}}
            }
            {div [class="editor-toolbar"]
                {span [class="toolbar-pill"]
                    {span [class={$ {_icon_class "content" "toolbar-icon"}}]}
                    "editor"}
                {span [class="toolbar-pill"]
                    {span [class={$ {_icon_class "preview" "toolbar-icon"}}]}
                    "preview"}
                {span [class="toolbar-pill"]
                    {span [class={$ {_icon_class "diagnostics" "toolbar-icon"}}]}
                    "diagnostics"}
                {span [class="toolbar-pill toolbar-pill-strong"]
                    {span [class={$ {_icon_class "save" "toolbar-icon"}}]}
                    {$ {if editable "save enabled" "read-only"}}}
            }
            {div [class="editor-meta"]
                {p
                    {span [class="meta-label"] "Path"}
                    {span [class="editor-path"] {$ {selected.get "rel_path" ""}}}}
                {p
                    {span [class="meta-label"] "Size"}
                    {span {$ {selected.get "size" 0}} " bytes"}}
                {p
                    {span [class="meta-label"] "Modified"}
                    {span [class="editor-path"] {$ {selected.get "modified" ""}}}}
            }
            {$ edit_form_node}
            {$ preview_node}
        }}
}


{fun browser_fragment_node [state]
    {$mrml_node section [class="studio-grid" id="browser"]
        {section [class="surface-panel explorer-panel"]
            {div [class="section-head"]
                {div
                    {p [class="meta-label"] "Explorer"}
                    {h2 "Site tree"}
                }
                {span [class="data-chip"] {$ {state.get "total_files" 0}} " files"}
            }
            {p [class="section-copy"]
                "Root: "
                {code {$ {state.get "site_root" ""}}}}
            {ul [class="explorer-list"]
                {$ {browser_entries_nodes {state.get "browser_entries" []}}}
            }
        }
        {$ {selected_file_panel_node state}}
        {$ {selected_context_panel_node state}}
    }
}


{fun overview_fragment_node [state]
    build_status = {state.get "build_status" {dict}}
    {$mrml_node section [class="overview-stack" id="overview"]
        {section [class="hero-ledger"]
            {div [class="hero-copy"]
                {p [class="meta-label"] "Architectural ledger"}
                {h1 {$ {state.get "app_title" "Hugrell"}}}
                {p [class="hero-lede"] {$ {state.get "tagline" ""}}}
            }
            {div [class="hero-meta"]
                {div [class="hero-chip-stack"]
                    {span [class="data-chip data-chip-strong"] {$ {state.get "site_name" ""}}}
                    {span [class="data-chip"] {$ {build_status.get "health" "Ready"}}}
                    {span [class="data-chip"] {$ {state.get "total_storage_text" "0 B"}}}
                }
                {p [class="muted"] "Built as a local-first MakrellPy showcase with MRON-backed configuration and Hugo-safe file access."}
            }
        }
        {section [class="summary-band"]
            {div [class="summary-stat"]
                {p [class="meta-label"] "Total files"}
                {p [class="summary-value"] {$ {state.get "total_files" 0}}}
            }
            {div [class="summary-stat"]
                {p [class="meta-label"] "Storage"}
                {p [class="summary-value"] {$ {state.get "total_storage_text" "0 B"}}}
            }
            {div [class="summary-stat"]
                {p [class="meta-label"] "Media"}
                {p [class="summary-value"] {$ {state.get "media_count" 0}}}
            }
            {div [class="summary-stat"]
                {p [class="meta-label"] "Layouts"}
                {p [class="summary-value"] {$ {state.get "layout_count" 0}}}
            }
        }
        {div [class="metric-grid"]
            {$ {metric_cards_nodes {state.get "sections" []}}}
        }
    }
}


{fun render_overview_fragment [state]
    build_status = {state.get "build_status" {dict}}
    {$mrml section [class="overview-stack" id="overview"]
        {section [class="hero-ledger hero-ledger-fragment"]
            {div [class="hero-copy"]
                {p [class="meta-label"] "Overview"}
                {h2 {$ {state.get "site_name" ""}}}
                {p [class="hero-lede"] "Local-first Hugo workspace, tuned for MRON and MakrellPy."}
            }
            {div [class="hero-chip-stack"]
                {span [class="data-chip data-chip-strong"] {$ {build_status.get "label" ""}}}
                {span [class="data-chip"] {$ {build_status.get "detail" ""}}}
            }
        }
        {div [class="metric-grid"]
            {$ {metric_cards_nodes {state.get "sections" []}}}
        }
    }
}


{fun render_browser_fragment [state]
    {$mrml section [class="studio-grid" id="browser"]
        {section [class="surface-panel explorer-panel"]
            {div [class="section-head"]
                {div
                    {p [class="meta-label"] "Explorer"}
                    {h2 "Site tree"}
                }
                {span [class="data-chip"] {$ {state.get "total_files" 0}} " files"}
            }
            {ul [class="explorer-list"]
                {$ {browser_entries_nodes {state.get "browser_entries" []}}}
            }
        }
        {$ {selected_file_panel_node state}}
        {$ {selected_context_panel_node state}}
    }
}


{fun render_home_page [state]
    build_status = {state.get "build_status" {dict}}
    build_label = "Build " + {build_status.get "last_build" ""}
    nav_nodes = {nav_items_node}
    overview_node = {overview_fragment_node state}
    browser_node = {browser_fragment_node state}
    recent_nodes = {recent_files_nodes {state.get "recent_files" []}}
    next_nodes = {next_steps_nodes {state.get "next_steps" []}}

    {$mrml html [lang="en"]
        {head
            {meta [charset="utf-8"]}
            {meta [name="viewport" content="width=device-width, initial-scale=1"]}
            {title {$ {state.get "app_title" "Hugrell"}}}
            {link [rel="stylesheet" href="/static/styles.css"]}
        }
        {body
            {div [class="app-shell"]
                {aside [class="side-nav"]
                    {div [class="brand-block"]
                        {p [class="brand-mark"] "Hugrell"}
                        {p [class="brand-subline"] "Static editing ledger"}
                    }
                    {nav [class="nav-list"]
                        {$ nav_nodes}
                    }
                    {div [class="side-cta"]
                        {a [class="primary-button" href="/?path=content/posts/hello.md"] "Open sample post"}
                        {p [class="side-note"] "No network services required. All state stays on this machine."}
                    }
                }
                {div [class="workspace-shell"]
                    {header [class="topbar"]
                        {div [class="topbar-search"]
                            {span [class={$ {_icon_class "search" "topbar-icon"}}]}
                            {div [class="topbar-search-copy"]
                                {p [class="meta-label"] "Search workspace"}
                                {p [class="topbar-value"] "Files, front matter, and templates"}
                            }
                        }
                        {div [class="topbar-block topbar-block-right"]
                            {div [class="topbar-site"]
                                {p [class="meta-label"] "Site root"}
                                {p [class="topbar-value"] {$ {state.get "site_root" ""}}}
                            }
                            {span [class="data-chip"] {$ build_label}}
                            {button [type="button" class="topbar-action" title="Notifications"]
                                {span [class={$ {_icon_class "notifications" "topbar-action-icon"}}]}}
                            {button [type="button" class="topbar-action" title="Settings"]
                                {span [class={$ {_icon_class "settings" "topbar-action-icon"}}]}}
                            {a [class="deploy-button" href="#deploy"]
                                {span [class={$ {_icon_class "deploy" "button-icon"}}]}
                                "Deploy"}
                            {a [class="ghost-button" href="/fragments/overview"] "Fragment endpoint"}
                        }
                    }
                    {main [class="workspace-main"]
                        {$ {flash_banner_node {state.get "flash"}}}
                        {$ overview_node}
                        {$ browser_node}
                        {section [class="supplement-grid"]
                            {section [class="surface-panel"]
                                {div [class="section-head"]
                                    {div
                                        {p [class="meta-label"] "Recent files"}
                                        {h2 "Editing cadence"}
                                    }
                                    {span [class="data-chip"]
                                        {span [class={$ {_icon_class "info" "chip-icon"}}]}
                                        {$ {len {state.get "recent_files" []}}} " tracked"}
                                }
                                {div [class="recent-list"]
                                    {$ recent_nodes}
                                }
                            }
                            {section [class="surface-panel" id="deploy"]
                                {div [class="section-head"]
                                    {div
                                        {p [class="meta-label"] "Implementation track"}
                                        {h2 "Next slices"}
                                    }
                                    {span [class="data-chip data-chip-strong"]
                                        {span [class={$ {_icon_class "spark" "chip-icon"}}]}
                                        {$ {build_status.get "health" ""}}}
                                }
                                {p [class="section-copy"] {$ {build_status.get "detail" ""}}}
                                {ul [class="step-list"]
                                    {$ next_nodes}
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
